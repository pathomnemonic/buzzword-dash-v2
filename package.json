{
  "name": "buzzword-dash",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A 3D endless-runner game for USMLE & COMLEX board prep",
  "scripts": {
    "soak": "node tools/soak.mjs",
    "audit:cards": "node tools/audit-cards.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.checked.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate:cards": "node tools/validate-cards.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "app:assets": "node tools/make-app-assets.mjs && capacitor-assets generate --android",
    "app:build": "node tools/build-app.mjs",
    "app:android": "node tools/build-app.mjs android",
    "preflight": "node tools/preflight.mjs",
    "analytics:docs": "node tools/analytics-docs.mjs",
    "analytics:report": "node tools/analytics-report.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "9.28.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "1.52.0",
    "@vitest/coverage-v8": "3.2.1",
    "axe-core": "^4.13.0",
    "eslint": "9.28.0",
    "globals": "16.1.0",
    "jsdom": "26.1.0",
    "meshoptimizer": "^1.3.0",
    "playwright": "1.52.0",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.1"
  },
  "dependencies": {
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "2.117.2",
    "capacitor-plugin-cdv-purchase": "^13.18.0",
    "jszip": "^3.10.1",
    "peerjs": "1.5.4",
    "sql.js": "^1.8.0",
    "three": "0.160.0"
  }
}
